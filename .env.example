# ---------------------------------------------------------------------------
# Application
#
# NOTE: NEXT_PUBLIC_* values are inlined into the bundle at BUILD time.
# This one must be present when `npm run build` runs — setting it only at
# start is too late, and every canonical URL, sitemap entry and Open Graph
# image will fall back to the built-in default.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://dadavar-law.ir"

# ---------------------------------------------------------------------------
# Database  (REQUIRED — MariaDB 10.5+ / MySQL 8+)
#
# Either DATABASE_URL, or the discrete DB_* values below. The URL wins.
# The database must exist; the application creates its own tables on first
# start. Use utf8mb4:
#   CREATE DATABASE dadavar CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://dadavar:password@127.0.0.1:3306/dadavar"

# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_NAME="dadavar"
# DB_USER="dadavar"
# DB_PASSWORD=""
# DB_SSL="false"
# DB_POOL_SIZE="10"

# How long a cached snapshot is served before the revision is re-checked.
# Only affects how stale another process's write can look. Milliseconds.
# DB_CACHE_MS="1000"

# ---------------------------------------------------------------------------
# Security  (REQUIRED IN PRODUCTION)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"
SESSION_MAX_AGE_SECONDS="28800"

# Number of reverse proxies in front of the app. Used to pick the real client
# IP out of X-Forwarded-For for rate limiting. 1 = a single nginx/Caddy.
TRUST_PROXY_HOPS="1"

# ---------------------------------------------------------------------------
# First administrator
#
# Used ONCE, when the database is empty. Required in production — there is no
# fallback password. Change it from the admin panel after first sign-in.
# Only this one account is created; add staff accounts from the panel so each
# has its own password.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@dadavar-law.ir"
SEED_ADMIN_PASSWORD=""

# Set to "true" to also seed sample enquiries, appointments and clients for
# evaluating the dashboard. Never enable on a live site.
SEED_DEMO_DATA="false"

# ---------------------------------------------------------------------------
# File storage
#
# IMPORTANT: point these at absolute paths OUTSIDE the deploy directory, or
# uploaded case documents and media are wiped on the next deployment.
# ---------------------------------------------------------------------------
UPLOAD_DIR="/var/lib/dadavar/uploads"
MEDIA_DIR="/var/lib/dadavar/media"
MAX_UPLOAD_BYTES="5242880"
MAX_MEDIA_BYTES="8388608"

# One-time import: if the database is empty on first start and this file
# exists, its contents are imported instead of the shipped seed. Used to carry
# content over from the previous file-backed store.
# DATA_IMPORT_FILE="/var/lib/dadavar/db.json"

# ---------------------------------------------------------------------------
# SMS — sms.ir
#
# Credentials live here, never in the admin panel: an editor with access to
# settings must not be able to read the account's API key. Behaviour and
# message wording are configured at /admin/settings/sms.
#
# The OTP template must be registered and approved in the sms.ir panel, and
# must contain the parameter named below (default: CODE).
# ---------------------------------------------------------------------------
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER=""
SMSIR_OTP_TEMPLATE_ID=""
SMSIR_OTP_PARAM_NAME="CODE"
# SMSIR_TIMEOUT_MS="10000"

# One-time code lifetime, and how long a completed verification stays usable
# while the visitor finishes filling in the form. Seconds.
OTP_TTL_SECONDS="120"
OTP_PROOF_TTL_SECONDS="1800"

# ---------------------------------------------------------------------------
# Content-Security-Policy escape hatches
#
# The policy allows only this origin plus Google Analytics. If an
# administrator needs to embed something else (a chat widget, a video player,
# a payment gateway), list its origin here — otherwise the pasted snippet will
# save successfully and then be silently blocked by the browser.
# Space-separated origins.
# ---------------------------------------------------------------------------
# CSP_SCRIPT_SRC="https://cdn.example.com"
# CSP_STYLE_SRC=""
# CSP_IMG_SRC=""
# CSP_MEDIA_SRC=""
# CSP_FONT_SRC=""
# CSP_CONNECT_SRC=""
# CSP_FRAME_SRC="https://www.aparat.com"
